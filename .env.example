# ===========================================
# MCP SQL Server - environment variables
# ===========================================
# Copy this file to .env (git-ignored) and fill in your own values.
# Every value below is a placeholder.
#
# These variables can also be set in the "env" block of the MCP client
# configuration. Variables already present in the environment win over the
# ones in a file loaded with ENV_FILE.

# -------------------------------------------
# Environment file (OPTIONAL)
# -------------------------------------------
# Path of a dotenv file to load before the configuration is validated.
# "~" is expanded; relative paths are resolved against the working directory.
# A missing or unreadable file stops the server (exit code 1).
# Not read from inside a file loaded this way (no chaining).
# ENV_FILE=~/.config/mcp-sql-server/prod.env

# -------------------------------------------
# SQL Server connection
# -------------------------------------------
# Configure it in ONE of two ways. If SQL_CONNECTION_URL is set it takes
# precedence over the individual parameters.

# OPTION 1: connection URL (URL-encode special characters in the password)
#   sqlserver://user:password@host:port/database?encrypt=true&TrustServerCertificate=false&instanceName=name
#   (mssql:// is accepted too)
# SQL_CONNECTION_URL=sqlserver://app_reader:change-me@db.example.com:1433/MyDatabase

# OPTION 2: individual parameters
# With the SSH tunnel enabled, SQL_SERVER:SQL_PORT is the database address
# as seen from the SSH host.
SQL_SERVER=db.example.com
SQL_DATABASE=MyDatabase
SQL_USER=app_reader
SQL_PASSWORD=change-me

# Port (default: 1433)
SQL_PORT=1433

# Named instance (OPTIONAL, e.g. "SQLEXPRESS" for host\SQLEXPRESS). The port is
# then resolved by the SQL Server Browser service (UDP 1434) and SQL_PORT is
# ignored. NOT supported together with the SSH tunnel: use SQL_PORT instead.
# SQL_INSTANCE=SQLEXPRESS

# Encrypt the connection (default: true)
SQL_ENCRYPT=true

# Accept the server certificate WITHOUT validating it (default: false).
# Only for development / self-signed certificates: it allows man-in-the-middle.
# With false, the certificate is validated against SQL_SERVER (also through the
# SSH tunnel, where the driver connects to 127.0.0.1).
SQL_TRUST_CERT=false

# -------------------------------------------
# Operation mode (REQUIRED)
# -------------------------------------------
#   true  = read-only (recommended): only SELECT / WITH queries
#   false = write tools sql_insert / sql_update / sql_delete are enabled
# The server does NOT start if this variable is not set.
# Also use a database login that can only read (db_datareader): see README.
READONLY=true

# -------------------------------------------
# Performance (OPTIONAL)
# -------------------------------------------
# Query timeout in milliseconds (default: 30000, max: 120000)
QUERY_TIMEOUT=30000

# Maximum rows returned per query (default: 1000, max: 5000)
MAX_ROWS=1000

# Maximum size of one query result in bytes, approximate
# (default: 10485760 = 10 MiB; min 1024, max 104857600)
MAX_RESULT_BYTES=10485760

# Connection pool size (defaults: POOL_MIN=2, POOL_MAX=10)
POOL_MIN=2
POOL_MAX=10

# -------------------------------------------
# Logging (OPTIONAL)
# -------------------------------------------
# debug, info, warn, error (default: info). Logs go to stderr.
LOG_LEVEL=info

# -------------------------------------------
# SSH tunnel (OPTIONAL)
# -------------------------------------------
# The tunnel is enabled when SSH_HOST is set. It listens on 127.0.0.1 only
# (random port). SSH_USER, SSH_KEY_PATH and SSH_HOST_FINGERPRINT are then required.
# SSH_HOST=bastion.example.com
# SSH_PORT=22
# SSH_USER=tunnel

# Private key path ("~" is expanded). With Docker: the path INSIDE the container.
# SSH_KEY_PATH=~/.ssh/mcp_tunnel_key

# Only for an encrypted key
# SSH_KEY_PASSPHRASE=

# Pinned host key fingerprint(s): SHA256:<43 base64 characters>, comma separated.
# Get it with: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
# SSH_HOST_FINGERPRINT=SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
